# Indigo2 IMPACT R10000 (IP28). Embedded PROM included; supply your own IRIX disk.
# See docs/indigo2-ip28.md. Paths are relative to the working directory.
headless   = false
no_audio   = false
banks      = [512, 512, 0, 0]
prom       = "" # optional external path; falls back to 070-1477-002.bin, then embedded IP28 PROM
nveeprom   = "ip28/nveeprom-ip28.bin"
serial_log = "ip28/console-ip28.log"
[machine]
profile = "indigo2_ip28"
cpu     = "r10000"
[graphics]
board = "solidimpact"
heads = 1
resolution = "guest"
[scsi.1]
path    = "ip28/blank.raw"
cdrom   = false
overlay = true

# Optional: a virtio-serial port for a guest that has a driver for it
# (see docs/virtio-serial.md). GIO expansion slot 1 by default.
# [virtio_serial]
# enabled = true
# [[virtio_serial.port]]
# console  = true
# tcp_port = 8890
