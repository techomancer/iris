# SGI Origin 3200 (IP35): one or two C-bricks and an I-brick, serial console.
# Copy to origin3200.toml and run from the repository root:
# iris --config origin3200.toml
# The IP35 PROM (6.210) is built in; `prom` overrides it with a raw payload or a
# version-six container. No disk images are included.
# Disks hang off the I-brick's Fibre Channel adapter, at xio15/pci0/1/lN, N the loop ID.

# prom = "ignore/origin3200/ip35prom.payload.bin"
nvram = "ignore/origin3200/nvram.bin"
# banks left unset: two 256 MiB banks in each C-brick.
headless = true
no_audio = true
monitor_port = 18888
serial_port_a = 18880
serial_port_b = 18881

[machine]
profile = "origin3200_ip35"
# 1 or 2 C-bricks; two are joined by the direct NUMAlink cable.
nodes = 2
console = "l1"
l1_port = 18882

[network]
mode = "off"

[[devices]]
type = "hdd"
at = "xio15/pci0/1/l1"
path = "ignore/origin3200/system.raw"
overlay = true

# Optional: the ICE1724 audio card in an I-brick PCI slot (bus1-slot2, bus1-slot3, bus2-slot1 or
# bus2-slot2). It plays as [audio] sets; unset no_audio for sound.
# [[devices]]
# type = "ice1724"
# at   = "bus1-slot2"
