# SGI Tezro (IP53 board, IP35 software platform), serial-only setup.
# Copy to tezro.toml and run from the repository root: iris --config tezro.toml
# The PROM is built in (the IRIX 6.5.30 media's 6.210); `prom` overrides it.
# Supply an IRIX disk installed on a Tezro: a disk installed on another machine
# carries that machine's device numbering.
# No disk images are included. Convert QCOW2 disks to raw first.

# prom = "ignore/tezro/ip35prom.payload.bin"
nvram = "ignore/tezro/nvram.bin"
# banks left unset: 4 GiB as 1024, 1024 and four 512 MiB banks.
headless = true
no_audio = true
monitor_port = 18888

[machine]
profile = "tezro_ip53"
# Optional; left out, or as the family "r16000", it is the 700 MHz R16000,
# "r16000_700". "r16000_800", "r16000_900" and "r16000_1000" are the others (four
# processors only); other values are refused.
cpu = "r16000_700"
# Processors fitted: 1, 2 or 4 (the default). Each runs on its own host thread.
cpus = 4
# 0 to 4095: the system serial the L1 answers with, LEMU2<emu_id>0, whose fold
# is IRIX's host id (emu_id 42 prints d5200420). 0, the default, is generic.
# emu_id = 42
flash = "ignore/tezro/flash.bin"
console = "l1"
l1_port = 18882

[graphics]
board = "none"

[network]
# Disconnected cable. For NAT, use mode = "nat".
mode = "off"

# Where each serial port is served: TCP on 127.0.0.1, in place of 8880 and up.
[[devices]]
type = "serial"
at = "serial1"
backend = "tcp:18880"

[[devices]]
type = "serial"
at = "serial2"
backend = "tcp:18881"

[[devices]]
type = "hdd"
at   = "scsi0/t1"
path = "ignore/tezro/irix.raw"
# Keep the base disk unchanged. Guest writes go to irix.raw.overlay.
overlay = true
# write_cache = false  # default true. false stores every write before it completes, like SGI's drives (slower); true can lose ~5 s of writes in a host crash. See STORAGE.md

# Optional: the ICE1724 audio controller behind the IO9's PCI bridge. It plays
# as [audio] sets (unset no_audio for sound); [audio] channels = 2, 4, 6 or 8 is
# how many speakers its channels fold down to.
# [[devices]]
# type = "ice1724"
# at   = "xio15/pci0/2/pci0/2"

# Optional, on the IO9's PCI bus, for a guest with drivers for them:
# a virtio-serial port (docs/dev/virtio-serial.md) and a host directory the
# guest mounts (docs/dev/virtio-9p.md). They take the bus's spare slots.
# [[devices]]
# type = "virtio_serial"
# [[devices.port]]
# tcp_port = 8890
# [[devices]]
# type = "virtio_9p"
# path = "ignore/tezro/share"
# tag     = "share"
