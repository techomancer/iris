# An SGI Octane (IP30): the stock PROM to IRIX 6.5.30 on a SCSI disk, with
# Solid IMPACT graphics and the Ethernet on the NAT gateway. See
# docs/octane-ip30.md and FEATURES.md ([octane]).
#
# Run:  iris --config octane.toml
# Console: telnet 127.0.0.1 8880 (IOC3 UART A). With a blank NVRAM the PROM
# picks the graphics console; set console=d for the serial one.

prom     = "IP30prom.bin"      # the 1 MB flash image (IRIX: /usr/cpu/firmware/IP30prom.bin)
nvram    = "octane-nvram.bin"  # the DS1685's NVRAM: the PROM's environment
banks    = [128]               # MB in each HEART bank: 64, 128, 256 or 512, filled from bank 0
serial_log = "octane-console.log"

[machine]
profile = "octane_ip30"
cpu     = "r10000"

[octane]
flash    = "octane-flash.bin"  # keep the PROM's flash records between runs (optional)
# graphics = "none"            # no graphics board: serial console, no window

[scsi.1]                       # id 1 on the internal bus, where IRIX expects its disk
path    = "irix6530.raw"
overlay = true
# write_cache = false             # default true. false stores every write before it completes, like SGI's drives (slower); true can lose ~5 s of writes in a host crash. See STORAGE.md
