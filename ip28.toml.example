# Indigo2 IMPACT R10000 (IP28). Supply your own IP28 PROM and IRIX disk.
# See docs/indigo2-ip28.md. Paths are relative to the working directory.
headless   = false
no_audio   = false
banks      = [512, 512, 0, 0]
prom       = "ip28/ip28prom.070-1477-002.bin"
nveeprom   = "ip28/nveeprom-ip28.bin"
serial_log = "ip28/console-ip28.log"
[machine]
profile = "indigo2_ip28"
cpu     = "r10000"
[graphics]
board = "solidimpact"
heads = 1
resolution = "guest"
[scsi.1]
path    = "ip28/blank.raw"
cdrom   = false
overlay = true
