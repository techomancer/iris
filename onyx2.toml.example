# SGI Onyx2 deskside (IP27 node boards, no graphics pipe), serial-only setup.
# Copy to onyx2.toml and run from the repository root:
#   iris --config onyx2.toml
# The IP27 PROM (the stock 6.156 image from the IRIX 6.5.30 distribution) is
# built in; `prom` overrides it. To boot IRIX, supply a raw IRIX 6.5.30 disk.
# No disk images are included. Convert QCOW2 disks to raw first.

# prom = "ignore/onyx2/ip27prom.img"
nvram = "ignore/onyx2/nvram.bin"
# One bank of a DIMM pair per node, in MB: 64, 128, 256 or 512 each.
banks = [128, 0, 0, 0]
headless = true
no_audio = true
monitor_port = 18988
# The IOC3's first port is the console.
serial_port_a = 18980
serial_port_b = 18981

[machine]
profile = "onyx2_ip27"
# r10000 (180 MHz, 1 MiB secondary cache) or r12000 (270 MHz, 4 MiB).
cpu = "r10000"

[onyx2]
# One or two node boards; two are joined by the direct cable.
nodes = 1
flash = "ignore/onyx2/flash.raw"
controller_store = "ignore/onyx2/controller.raw"
# The BaseIO's I/O PROM (io6prom.img on the IRIX 6.5.30 media) is built in; name an
# image here to override it.
# io_prom = "ignore/onyx2/io6prom.img"

[network]
# Disconnected cable. For NAT, use mode = "nat".
mode = "off"

[scsi.1]
path = "ignore/onyx2/irix.raw"
cdrom = false
# Keep the base disk unchanged. Guest writes go to irix.raw.overlay.
overlay = true
