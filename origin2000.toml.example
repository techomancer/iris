# SGI Origin 2000 deskside (IP27 node boards), serial-only setup.
# Copy to origin2000.toml and run from the repository root:
#   iris --config origin2000.toml
# The IP27 PROM (the stock 6.156 image from the IRIX 6.5.30 distribution) is
# built in; `prom` overrides it. To boot IRIX, supply a raw IRIX 6.5.30 disk.
# No disk images are included. Convert QCOW2 disks to raw first.

# prom = "ignore/origin2000/ip27prom.img"
nvram = "ignore/origin2000/nvram.bin"
# One bank of a DIMM pair per node, in MB: 64, 128, 256 or 512 each.
banks = [128, 0, 0, 0]
headless = true
no_audio = true
monitor_port = 18988

[machine]
profile = "origin2000_ip27"
# r10000 (180 MHz, 1 MiB secondary cache) or r12000 (270 MHz, 4 MiB).
cpu = "r10000"
# One or two node boards; two are joined by the direct cable.
nodes = 1
flash = "ignore/origin2000/flash.raw"
controller_store = "ignore/origin2000/controller.raw"
# The BaseIO's I/O PROM (io6prom.img on the IRIX 6.5.30 media) is built in; name an
# image here to override it.
# io_prom = "ignore/origin2000/io6prom.img"

[network]
# Disconnected cable. For NAT, use mode = "nat".
mode = "off"

# Where each serial port is served: TCP on 127.0.0.1, in place of 8880 and up.
[[devices]]
type = "serial"
at = "serial1"
backend = "tcp:18980"

[[devices]]
type = "serial"
at = "serial2"
backend = "tcp:18981"

[[devices]]
type = "hdd"
at   = "scsi0/t1"
path = "ignore/origin2000/irix.raw"
# Keep the base disk unchanged. Guest writes go to irix.raw.overlay.
overlay = true
