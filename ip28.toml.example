# Indigo2 IMPACT R10000 (IP28). The PROM is built in; supply your own IRIX disk.
# See docs/indigo2-ip28.md. Paths are relative to the working directory.
headless   = false
no_audio   = false
banks      = [512, 512, 0, 0]
# prom     = "ip28/070-1477-002.bin" # optional override; left unset, prom.bin or 070-1477-002.bin in the
#                                     # working directory is used if present, else the built-in IP28 PROM
nveeprom   = "ip28/nveeprom-ip28.bin"
serial_log = "ip28/console-ip28.log"
[machine]
profile = "indigo2_ip28"
cpu     = "r10000"
[[devices]]
type  = "impact"
model = "solid"
[[devices]]
type = "hdd"
at   = "scsi0/t1"
path    = "ip28/blank.raw"
overlay = true

# Optional: a virtio-serial port for a guest that has a driver for it
# (see docs/dev/virtio-serial.md), in GIO slot gio1 or gio0.
# [[devices]]
# type = "virtio_serial"
# at   = "gio1"
# [[devices.port]]
# console  = true
# tcp_port = 8890

# Optional: a host directory the guest mounts (see docs/dev/virtio-9p.md). If
# virtio-serial is on too, give each its own slot.
# [[devices]]
# type = "virtio_9p"
# at   = "gio0"
# path = "/path/on/the/host"
# tag  = "share"
